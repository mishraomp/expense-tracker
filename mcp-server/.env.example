# Copy this file to mcp-server/.env and fill it in.

# The running backend's API base URL.
EXPENSE_API_BASE_URL=http://localhost:3000/api/v1

# Must match MCP_LOCAL_BYPASS_SECRET in backend/.env exactly.
MCP_BYPASS_SECRET=

# HTTP listen port. Only used by `npm run start:http`; the stdio entry point
# (`npm start` / `npm run dev`) ignores this.
PORT=3400
