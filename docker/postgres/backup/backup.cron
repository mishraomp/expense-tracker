# Crontab for automated Postgres backups
# Runs daily at 10:00 container time (set TZ via env to control timezone)
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# minute hour day month weekday command
0 10 * * * . /scripts/env.sh && /scripts/backup.sh >> /var/log/pg-backup.log 2>&1
